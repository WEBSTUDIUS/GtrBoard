{
  "format": "com.andreyilin.gtrboard.preset",
  "version": 1,
  "preset": {
    "name": "Linkin Park — Hybrid Theory Rhythm",
    "author": "GtrBoard tone lab",
    "gear": "Dual Rectifier high gain · tight boost · dry 4x12",
    "tags": [
      "linkin park",
      "hybrid theory",
      "one step closer",
      "papercut",
      "nu metal",
      "drop d",
      "rhythm"
    ],
    "notes": "Hybrid Theory / Meteora rhythm: drop-D, bridge humbucker, tight low end, high gain but more upper-mid bite than Metallica. Dry, no reverb. Use firm palm mutes; roll the guitar tone back slightly for One Step Closer.",
    "settings": {
      "units": [
        {
          "kind": "gate",
          "enabled": true,
          "params": {
            "threshold": -48,
            "decay": 90,
            "range": 70
          }
        },
        {
          "kind": "compressor",
          "enabled": false
        },
        {
          "kind": "boost",
          "enabled": false
        },
        {
          "kind": "overdrive",
          "enabled": true,
          "params": {
            "drive": 8,
            "tone": 0.55,
            "level": -5,
            "mid": 0.7
          }
        },
        {
          "kind": "distortion",
          "enabled": false
        },
        {
          "kind": "fuzz",
          "enabled": false
        },
        {
          "kind": "amp",
          "enabled": true,
          "params": {
            "gain": 24,
            "bass": 1,
            "mid": 0.5,
            "treble": 2,
            "presence": 5,
            "master": -9,
            "voicing": 3
          }
        },
        {
          "kind": "cabinet",
          "enabled": true,
          "params": {
            "lowCut": 95,
            "highCut": 5200,
            "resonance": 5
          }
        },
        {
          "kind": "chorus",
          "enabled": false
        },
        {
          "kind": "flanger",
          "enabled": false
        },
        {
          "kind": "phaser",
          "enabled": false
        },
        {
          "kind": "tremolo",
          "enabled": false
        },
        {
          "kind": "delay",
          "enabled": false
        },
        {
          "kind": "reverb",
          "enabled": false
        }
      ],
      "graphicEQ": {
        "enabled": true,
        "gains": [
          -4,
          -1,
          2,
          3,
          0,
          -2,
          0,
          2,
          1,
          -3
        ]
      },
      "masterVolume": -8,
      "outputTrim": 4.3,
      "limiter": true,
      "bypass": false
    }
  }
}
