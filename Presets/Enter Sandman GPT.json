{
  "format": "com.andreyilin.gtrboard.preset",
  "version": 1,
  "preset": {
    "name": "Enter Sandman — Black Album Rhythm",
    "author": "GtrBoard tone lab",
    "gear": "Mesa Mark/Recto high gain · TS-style boost · closed 4x12",
    "tags": [
      "metallica",
      "enter sandman",
      "black album",
      "metal",
      "high gain",
      "rhythm"
    ],
    "notes": "Tight, scooped Black Album rhythm: TS-style overdrive tightens the low end, high-gain amp with a small room for the record’s ambience. Bridge humbucker, standard E, firm palm muting. Approximation on GtrBoard’s DSP, not an amp capture.",
    "settings": {
      "units": [
        {
          "kind": "gate",
          "enabled": true,
          "params": {
            "threshold": -50,
            "decay": 120,
            "range": 65
          }
        },
        {
          "kind": "compressor",
          "enabled": false
        },
        {
          "kind": "boost",
          "enabled": false
        },
        {
          "kind": "overdrive",
          "enabled": true,
          "params": {
            "drive": 12,
            "tone": 0.45,
            "level": -5,
            "mid": 0.75
          }
        },
        {
          "kind": "distortion",
          "enabled": false
        },
        {
          "kind": "fuzz",
          "enabled": false
        },
        {
          "kind": "amp",
          "enabled": true,
          "params": {
            "gain": 28,
            "bass": 1.5,
            "mid": -0.5,
            "treble": 2,
            "presence": 5,
            "master": -10,
            "voicing": 3
          }
        },
        {
          "kind": "cabinet",
          "enabled": true,
          "params": {
            "lowCut": 90,
            "highCut": 5000,
            "resonance": 5
          }
        },
        {
          "kind": "chorus",
          "enabled": false
        },
        {
          "kind": "flanger",
          "enabled": false
        },
        {
          "kind": "phaser",
          "enabled": false
        },
        {
          "kind": "tremolo",
          "enabled": false
        },
        {
          "kind": "delay",
          "enabled": false
        },
        {
          "kind": "reverb",
          "enabled": true,
          "params": {
            "size": 0.25,
            "damping": 0.6,
            "mix": 0.05,
            "predelay": 8,
            "mode": 0
          }
        }
      ],
      "graphicEQ": {
        "enabled": true,
        "gains": [
          -5,
          -2,
          3,
          4,
          -1,
          -4,
          -2,
          2,
          1,
          -5
        ]
      },
      "masterVolume": -9,
      "outputTrim": 6.5,
      "limiter": true,
      "bypass": false
    }
  }
}
