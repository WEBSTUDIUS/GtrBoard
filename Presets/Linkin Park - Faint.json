{
  "format": "com.andreyilin.gtrboard.preset",
  "version": 1,
  "preset": {
    "name": "Linkin Park — Faint / Given Up",
    "author": "GtrBoard tone lab",
    "gear": "Aggressive high gain · fast gate · bright 4x12",
    "tags": [
      "linkin park",
      "faint",
      "given up",
      "meteora",
      "nu metal",
      "drop d",
      "aggressive"
    ],
    "notes": "The more aggressive end of the Linkin Park catalogue: faster gate, more gain, brighter presence and a tighter low cut for Faint / Given Up-style riffs. Still dry — no reverb.",
    "settings": {
      "units": [
        {
          "kind": "gate",
          "enabled": true,
          "params": {
            "threshold": -46,
            "decay": 70,
            "range": 75
          }
        },
        {
          "kind": "compressor",
          "enabled": false
        },
        {
          "kind": "boost",
          "enabled": false
        },
        {
          "kind": "overdrive",
          "enabled": true,
          "params": {
            "drive": 14,
            "tone": 0.55,
            "level": -5,
            "mid": 0.7
          }
        },
        {
          "kind": "distortion",
          "enabled": false
        },
        {
          "kind": "fuzz",
          "enabled": false
        },
        {
          "kind": "amp",
          "enabled": true,
          "params": {
            "gain": 30,
            "bass": 0.5,
            "mid": 0,
            "treble": 2.5,
            "presence": 6,
            "master": -10,
            "voicing": 3
          }
        },
        {
          "kind": "cabinet",
          "enabled": true,
          "params": {
            "lowCut": 105,
            "highCut": 5000,
            "resonance": 4
          }
        },
        {
          "kind": "chorus",
          "enabled": false
        },
        {
          "kind": "flanger",
          "enabled": false
        },
        {
          "kind": "phaser",
          "enabled": false
        },
        {
          "kind": "tremolo",
          "enabled": false
        },
        {
          "kind": "delay",
          "enabled": false
        },
        {
          "kind": "reverb",
          "enabled": false
        }
      ],
      "graphicEQ": {
        "enabled": true,
        "gains": [
          -5,
          -2,
          2,
          3,
          -1,
          -3,
          0,
          2,
          1,
          -4
        ]
      },
      "masterVolume": -9,
      "outputTrim": 3.4,
      "limiter": true,
      "bypass": false
    }
  }
}
